# ---------------------------------------------------------------------------
# Storefront identity (used in JSON-LD, canonical URLs, hreflang + sitemaps)
# ---------------------------------------------------------------------------
# Inlined at build time — set before `npm run build`.
NEXT_PUBLIC_SITE_URL=https://www.yourhoodiebrand.com
NEXT_PUBLIC_BRAND_NAME=Northloop Supply Co.
# Short form used inside title tags (falls back to the brand name minus "Supply Co.")
NEXT_PUBLIC_BRAND_SHORT=Northloop
NEXT_PUBLIC_BRAND_TAGLINE=Heavyweight hoodies, built for every climate.
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
NEXT_PUBLIC_SUPPORT_EMAIL=help@yourhoodiebrand.com

# Comma separated BCP-47 locales you actually serve (drives hreflang + sitemaps)
NEXT_PUBLIC_MARKET_LOCALES=en-US,en-GB,de-DE,fr-FR,es-ES,ja-JP,ar-AE,en-AU,en-CA

# ---------------------------------------------------------------------------
# AI provider for the copy-refinement stage of the SEO engine (OPTIONAL).
# When unset, the on-device deterministic NLP engine runs alone — every
# feature of the platform still works, no network access required.
# ---------------------------------------------------------------------------
# SEO_AI_PROVIDER=openai | anthropic | openrouter | custom
SEO_AI_PROVIDER=
SEO_AI_MODEL=gpt-4o-mini
SEO_AI_API_KEY=
SEO_AI_BASE_URL=
SEO_AI_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Search / merchandising
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CURRENCY=USD
SEO_MIN_CONTENT_WORDS=320
SEO_AUTO_OPTIMIZE_ON_CREATE=true

# Origins allowed to embed the site in an iframe (Content-Security-Policy: frame-ancestors).
# X-Frame-Options is deliberately not sent: it cannot allowlist other origins.
FRAME_ANCESTORS='self' https://*.e2b.app

# Set to 1 only if the site is genuinely served over plain http on a public host.
# ALLOW_HTTP_ORIGIN=1
